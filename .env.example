# GEMINI_API_KEY: Clave de API de Google Gemini (requerida para generación de manuales con IA)
GEMINI_API_KEY=""

# GEMINI_MODEL: Modelo predeterminado para análisis y redacción (por defecto gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: URL base pública donde se aloja la aplicación en producción (Cloud Run / Vercel / etc.)
APP_URL=""

# ALLOWED_ORIGINS: Lista separada por comas de orígenes CORS permitidos adicionales además de localhost
ALLOWED_ORIGINS=""
