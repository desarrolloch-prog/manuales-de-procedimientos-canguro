irma_freddy_molina.png\n/public/assets/signatures/firma_jeanette_arvelo.png\n/public/assets/signatures/firma_natalia_rodriguez.png\n/server.ts\n/src/App.tsx\n/src/components/DiagnosticView.tsx\n/src/components/DynamicSelect.tsx\n/src/components/ErrorBoundary.tsx\n/src/components/GoogleDriveSyncCard.tsx\n/src/components/Header.tsx\n/src/components/InterviewWizard.tsx\n/src/components/ManualEditor.tsx\n/src/components/ManualPageRenderer.tsx\n/src/components/ManualPreview.tsx\n/src/components/ManualsDatabaseView.tsx\n/src/components/RibbonToolbar.tsx\n/src/components/SavedManualsModal.tsx\n/src/components/SettingsModal.tsx\n/src/data/canguroStructure.ts\n/src/data/sampleManual.ts\n/src/index.css\n/src/main.tsx\n/src/services/googleDriveService.ts\n/src/types/processManual.ts\n/src/utils/docxExport.ts\n/src/utils/markdownUtils.ts\n/src/utils/officialSignatures.ts\n/src/utils/paginate.ts\n/src/utils/pdfExport.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.3.3\n@vitejs/plugin-react: ^6.1.1\ndocx: ^9.13.0\ndotenv: ^17.2.3\nexpress: ^4.21.2\nfirebase: ^13.2.0\nhtml-to-image: ^1.11.13\nhtml2canvas: ^1.4.1\njspdf: ^4.2.1\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^8.3.0\n\nThe following devDependencies are installed:\n@types/express: ^4.17.21\n@types/node: ^22.14.0\n@types/react: ^19.3.0\n@types/react-dom: ^19.3.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.3.3\ntsx: ^4.21.0\ntypescript: ^7.0.2\n\nKey file contents:\n\n--- /.aistudio/artifacts/brain/02c94b94-b8ed-443f-bc3d-60c54a71ee2a/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para incorporar una pesta\303\261a principal dedicada a la Base de Datos de Manuales con gesti\303\263n de estados (Borrador, En Pruebas, Aprobado), guardado autom\303\241tico continuo, creaci\303\263n de manual en blanco y eliminaci\303\263n segura.\",\n  \"updatedAt\":  \"2026-10-28T15:42:28.796994649Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/0d34512c-0c07-4ef8-b788-ff33d7bc7d81/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan de implementaci\303\263n para aplicar las correcciones solicitadas: 1) Estandarizar negritas intermedias en Gerencia y Direcci\303\263n tanto en Secci\303\263n 1 como en Secci\303\263n 3 (agregando el art\303\255culo \'la\' faltante), 2) Retirar la etiqueta \'[X registrados]\' del t\303\255tulo en la base de datos, 3) Retirar la tarjeta m\303\251trica de \'BORRADORES\' dejando Total Manuales y Aprobados, 4) Retirar los botones secundarios \'Descargar\' y \'Subir\' de la sincronizaci\303\263n de Google Drive dejando el bot\303\263n unificado \'Sincronizar (Subir y Descargar)\'.\",\n  \"updatedAt\": \"2026-11-05T12:58:15.565918565Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/23d63a4e-bda2-4d61-834f-92a555b02f04/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan de implementaci\303\263n para estandarizar las p\303\241ginas del manual y la exportaci\303\263n PDF a las dimensiones oficiales de Visio (A4 horizontal: 297 x 210 mm, ratio 1.414), con paginaci\303\263n din\303\241mica continua y presencia garantizada del encabezado y cuadro de firmas en todas las p\303\241ginas sin recortes.\",\n  \"updatedAt\": \"2026-11-05T15:06:04.195535524Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/26197d4b-c192-4af4-abcf-ecfccbe9bc99/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan integral de arquitectura para la estandarizaci\303\263n determinista de manuales DTH-GFD-MP:\\n1. Reemplazo del prompt de Gemini por salida JSON estructurada (responseMimeType: application/json) sin paginaci\303\263n en el LLM.\\n2. M\303\263dulo \303\272nico de paginaci\303\263n real por medici\303\263n de altura f\303\255sica en DOM (src/utils/paginate.ts) con bloques at\303\263micos y ajuste de espaciado Word-like (1.0).\\n3. Hojas fijas A4 apaisadas (1120x792 px) con Arial 9.5pt, line-height 1.35 y eliminaci\303\263n de c\303\263digo duplicado.\\n4. Exportaci\303\263n id\303\251ntica en PDF y DOCX compartiendo el array de p\303\241ginas paginadas.\",\n  \"updatedAt\": \"2026-11-05T16:13:11.491219790Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/372011d2-eeda-4eaa-be50-09dd0e7828cc/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan de implementaci\303\263n detallado para replicar con exactitud el est\303\241ndar Visio del Manual de Procedimientos DTH-GFD-MP de Districueros El Canguro C.A., incluyendo el nuevo dise\303\261o de encabezados (\303\263valo con n\303\272mero + barra amarilla redondeada), distribuci\303\263n can\303\263nica de 6 p\303\241ginas y cuadro oficial de 4 firmas en todas las p\303\241ginas.\",\n  \"updatedAt\": \"2026-11-06T13:06:37.530814565Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/49a46d18-fab8-48d0-9d24-a814ceaaabc7/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para corregir las 3 observaciones detectadas en el PDF:\\n1) Consolidar el Glosario de T\303\251rminos en una (1) sola p\303\241gina sin saltos err\303\263neos, dando cabida anal\303\255tica completa de hasta 10 t\303\251rminos de alta calidad en la P\303\241gina 3.\\n2) Limpiar el listado de Herramientas Tecnol\303\263gicas para mostrar exclusivamente los nombres formales del software sin m\303\263dulos ni textos entre par\303\251ntesis.\\n3) Optimizar el presupuesto vertical en Normas y Criterios T\303\251cnicos para aprovechar todo el alto \303\272til de la p\303\241gina (586px), integrando los 4 cargos en la P\303\241gina 5 y los 5 criterios t\303\251cnicos (4.1 a 4.5) en la misma hoja de Criterios sin saltos prematuros, reservando el salto \303\272nicamente para 6 o m\303\241s criterios analizados.\",\n  \"updatedAt\":  \"2026-11-10T12:29:27.136543586Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/4e173361-af60-4372-82cf-d83c376849c9/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n arquitect\303\263nica para corregir el aislamiento de estado entre manuales en la base de datos, eliminar la visualizaci\303\263n de asteriscos dobles (**) al salir de edici\303\263n convirti\303\251ndolos en negritas reales, y actualizar el est\303\241ndar de gobernanza documental en Secci\303\263n 10 a \'Del Gerente de [Proceso en Title Case]\'.\",\n  \"updatedAt\":  \"2026-11-12T14:54:42.647373918Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/706f4c7a-3c8f-4a2c-a8c6-aad91a47235c/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan para habilitar pantalla completa nativa del monitor y escalado proporcional din\303\241mico (Scale-to-fit) en el modo presentaci\303\263n para eliminar cualquier corte de firmas o secciones.\",\n  \"updatedAt\": \"2026-11-03T14:15:26.841462703Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/77743366-7f10-4e55-82a8-fdfdf443e6a4/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de auditor\303\255a e implementaci\303\263n t\303\251cnica para corregir el motor de an\303\241lisis multimodal y la paginaci\303\263n din\303\241mica:\\n1. Reconfiguraci\303\263n del backend y prompt de Gemini para eliminar l\303\255mites artificiales de cargos (extracci\303\263n obligatoria del 100% de descriptores adjuntos), erradicar fallbacks silenciosos que generaban glosarios y criterios predeterminados, y ampliar la capacidad de recepci\303\263n de archivos pesados (hasta 100MB).\\n2. Refactorizaci\303\263n del motor de paginaci\303\263n can\303\263nico (src/utils/paginate.ts) para distribuir exactamente un m\303\241ximo de 3 cargos por p\303\241gina en la Secci\303\263n 3 (Estructura Organizacional), generando p\303\241ginas adicionales din\303\241micas seg\303\272n la cantidad de cargos (ej. 9 cargos divididos en 3 p\303\241ginas: 3+3+3), manteniendo Portada en P\303\241g 1, Herramientas en P\303\241g 2, Glosario en P\303\241g 3, Normas 1 y 2 en P\303\241g 4, y Criterios T\303\251cnicos en p\303\241ginas subsiguientes con pie de firmas en todas las p\303\241ginas.\\n3. Transparencia de an\303\241lisis en la UI y sincronizaci\303\263n completa de conteo total de p\303\241ginas.\",\n  \"updatedAt\":  \"2026-11-10T14:36:52.250755589Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/85ec02d2-aed6-434c-91d8-309468ba1fd9/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\": \"Plan de implementaci\303\263n para la sincronizaci\303\263n bidireccional multiusuario con Google Drive. Permite que cualquier usuario con cuenta de Google autenticada descargue y suba manuales a la base de datos corporativa compartida, implementando un motor de fusi\303\263n inteligente que preserva las versiones m\303\241s recientes sin p\303\251rdida de datos.\",\n  \"updatedAt\": \"2026-11-04T15:44:11.919645288Z\",\n  \"requestFeedback\": true,\n  \"userFacing\": true\n}\n```\n\n--- /.aistudio/artifacts/brain/9f65f12a-639b-4274-a087-f5402dcfa78b/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para el auto-guardado inteligente tras 5 segundos de pausa en la edici\303\263n, la integraci\303\263n del interruptor en el panel de Google Drive y los indicadores visuales discretos de \'Sincronizado\' frente a \'Guardado localmente\' en la barra superior y en la tarjeta de sincronizaci\303\263n.\",\n  \"updatedAt\":  \"2026-11-12T13:38:18.896127449Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/c43add3c-df1c-42f4-b9d7-6b55662b554b/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para renovar la barra superior a un estilo ejecutivo moderno con efecto vidrio y badges, incorporar el gestor modal de Direcciones y Directores Aprobadores con persistencia en localStorage, y limpiar la etiqueta de Direcci\303\263n Adscrita.\",\n  \"updatedAt\":  \"2026-10-28T14:29:28.838180304Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/d567fb2d-9431-469b-a80e-b05fccbce0a1/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para corregir la extracci\303\263n de la visi\303\263n extendida del proceso y el glosario de t\303\251rminos mediante an\303\241lisis multimodal exhaustivo de documentos e im\303\241genes suministrados, eliminando cualquier t\303\251rmino predeterminado y asegurando fidelidad absoluta a la informaci\303\263n del usuario.\",\n  \"updatedAt\":  \"2026-11-09T12:41:35.648990708Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/e55aa174-3ea6-493c-b309-779484775c79/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan integral para implementar la barra minimalista flotante de navegaci\303\263n y tipograf\303\255a, eliminar la precarga autom\303\241tica del manual, integrar carga y extracci\303\263n de archivos (PDF, JSON, TXT), reescribir con est\303\241ndar riguroso ISO 9001 el prompt de generaci\303\263n de manuales y optimizar el gestor de base de datos.\",\n  \"updatedAt\":  \"2026-10-29T13:22:16.233781636Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/f04ae52e-cdd9-406f-9001-07613e43e89b/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan de implementaci\303\263n para corregir exhaustivamente los errores de sincronizaci\303\263n con Google Drive (autenticaci\303\263n popup/dominio, permisos 403/404, fallback autom\303\241tico a carpeta propia y respaldo local directo JSON) e implementar la personalizaci\303\263n y edici\303\263n directa en el documento del texto \'(CONTINUACI\303\223N)\' con control de formato en la barra de herramientas.\",\n  \"updatedAt\":  \"2026-11-10T15:27:22.247800723Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.aistudio/artifacts/brain/fb7ef2bc-0c95-4fe3-bc98-02d81808fd44/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Plan detallado de implementaci\303\263n para corregir y optimizar la interacci\303\263n del usuario:\\n- Desacoplar la carga del caso de ejemplo para que solo llene los par\303\241metros y no renderice un manual anticipado sin hacer clic en \'Generar\'.\\n- Eliminar textos y etiquetas innecesarias en encabezados y campos (c\303\263digo DTH-GFD-MP redundante, \'Metadatos oficiales y notas\', \'Cargo...\' bajo Director Aprobador, \'(Cargo Responsable)\' en Due\303\261o del Proceso, \'Haz clic en cualquier palabra para editarla\' y el bot\303\263n inoperativo \'100%\' de accesibilidad).\\n- Simplificar el control de Edici\303\263n a un bot\303\263n compacto y funcional con icono + \'Edici\303\263n\' y activaci\303\263n directa.\\n- Reemplazar los dos contadores de segundos por una barra de progreso unificada con porcentaje (0% a 100%) y fases visuales de an\303\241lisis.\\n- Eliminar el guardado autom\303\241tico para dar control total al usuario con un bot\303\263n destacado \'Guardar Manual\' con indicador de cambios pendientes y \303\272ltima hora de guardado.\\n- Sintetizar la secci\303\263n 2 de Errores Lean a un resumen ejecutivo \303\241gil y potenciar el an\303\241lisis de casos en el backend.\",\n  \"updatedAt\":  \"2026-10-28T19:04:05.596516310Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# GEMINI_MODEL: Model to use for the analysis and drafting pipeline. Defaults to gemini-3.8-flash.\nGEMINI_MODEL=\"gemini-3.8-flash\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n\n```\n\n--- /firebase-applet-config.json ---\n```json\n{\n  \"projectId\": \"gen-lang-client-0908848263\",\n  \"appId\": \"1:977190300435:web:814269f0a4a586943ec8e6\",\n  \"apiKey\": \"AIzaSyDC8BHucKMi9Q28kdUOLiZzLwhahDD72M0\",\n  \"authDomain\": \"gen-lang-client-0908848263.firebaseapp.com\",\n  \"storageBucket\": \"gen-lang-client-0908848263.firebasestorage.app\",\n  \"messagingSenderId\": \"977190300435\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"977190300435-hnbr9hdlui8dtvu6annk3258c156dl0f.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"es\" class=\"h-full bg-zinc-950\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Remix Remix Remix Remix D.O Automatizaci\303\263n - Manuales de Procedimientos</title>\n    <meta name=\"description\" content=\"Plataforma para levantamiento \303\241gil de entrevistas, estructuraci\303\263n de gobernanza, RACI, SIPOC y generaci\303\263n automatizada de manuales de procedimientos corporativos para Canguro Venezuela.\" />\n    <meta property=\"og:title\" content=\"Remix Remix Remix Remix D.O Automatizaci\303\263n - Manuales de Procedimientos\" />\n    <meta property=\"og:description\" content=\"Plataforma para levantamiento \303\241gil de entrevistas, estructuraci\303\263n de gobernanza, RACI, SIPOC y generaci\303\263n automatizada de manuales de procedimientos corporativos para Canguro Venezuela.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap\" rel=\"stylesheet\" crossorigin=\"anonymous\">\n    <script src=\"https://accounts.google.com/gsi/client\" async defer></script>\n  </head>\n  <body class=\"bg-zinc-950 text-zinc-100 font-sans antialiased min-h-screen selection:bg-yellow-400 selection:text-black\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \" Automatizaci\303\263n de Procesos - Manuales de Procedimientos\",\n  \"description\": \"Plataforma para levantamiento \303\241gil de entrevistas, estructuraci\303\263n de gobernanza, RACI, SIPOC y generaci\303\263n automatizada de manuales de procedimientos corporativos para Canguro Venezuela.\",\n  \"requestFramePermissions\": [\n    \"microphone\"\n  ],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect, useLayoutEffect, useMemo, useRef } from \'react\';\nimport {\n  FileText,\n  FileSpreadsheet,\n  Copy,\n  Mic,\n  MicOff,\n  CheckCircle2,\n  AlertTriangle,\n  RotateCcw,\n  Edit3,\n  Zap,\n  Sparkles,\n  ChevronDown,\n  Plus,\n  Trash2,\n  X,\n  Upload,\n  Maximize2,\n  Minimize2,\n  Check,\n  Download,\n  Loader2,\n  Database,\n  FilePlus2,\n  FolderOpen,\n  Save,\n  Clock,\n  Paperclip,\n  FileCode,\n  File,\n  Calendar,\n  Users,\n  ChevronLeft,\n  ChevronRight,\n  Presentation,\n  Settings,\n  UserCheck\n} from \'lucide-react\';\nimport {\n  DIRECCIONES_CANGURO,\n  DIRECTORES_POR_DIRECCION,\n  CODIGOS_NUMERICOS,\n  VERSIONES_NUMERICAS,\n  CLASIFICACIONES_PROCESO,\n  EJEMPLO_REAL_LOGISTICA\n} from \'./data/canguroStructure\';\nimport { exportManualToWordDoc } from \'./utils/docxExport\';\nimport { exportManualToPdf, exportDiagnosticToPdf, exportManualToPdfBlob } from \'./utils/pdfExport\';\nimport { domToMarkdown, domToMarkdownLine, formatInline, stripMarkdown, toTitleCase } from \'./utils/markdownUtils\';\nimport { StoredManualRecord, ManualStatus, ManualData, CargoData, CriterioData, GlosarioItem, ProcessMetadata, IntermediatePage, sanitizeCargoTitle } from \'./types/processManual\';\nimport { ManualsDatabaseView } from \'./components/ManualsDatabaseView\';\nimport { RibbonToolbar, type SyncStatusType } from \'./components/RibbonToolbar\';\nimport { DiagnosticView } from \'./components/DiagnosticView\';\nimport { DynamicSelect } from \'./components/DynamicSelect\';\nimport { SettingsModal, type DirectorConfigItem } from \'./components/SettingsModal\';\nimport {\n  getAccessToken,\n  getValidAccessToken,\n  verifyDriveFileExists,\n  syncSingleManualToGoogleDrive,\n  syncDatabaseToGoogleDrive,\n  recordDeletedManualTombstone,\n  clearDeletedTombstoneForManuals,\n  googleSignIn,\n  auth\n} from \'./services/googleDriveService\';\nimport {\n  usePaginatedManual,\n  parseLegacyMarkdownToManualData,\n  manualDataToMarkdown,\n  buildDefaultManualData,\n  type PaginatedPage,\n  type ContentBlock\n} from \'./utils/paginate\';\nimport {\n  FIRMA_FREDDY_MOLINA,\n  FIRMA_NATALIA_RODRIGUEZ,\n  FIRMA_ALEJANDRA_AREVALO,\n  FIRMA_JEANETTE_ARVELO,\n  getOfficialSignatureFallback\n} from \'./utils/officialSignatures\';\nimport {\n  SectionPillBanner,\n  CargoBlockView,\n  RenderBlockView,\n  PaginatedContentSections,\n  parseEmbeddedVinetas\n} from \'./components/ManualPageRenderer\';\nimport { ErrorBoundary } from \'./components/ErrorBoundary\';\n\nexport interface SignerSlot {\n  id: string;\n  roleLabel: string;\n  name: string;\n  position: string;\n  signatureUrl: string;\n  defaultSignatureUrl: string;\n  defaultName: string;\n  defaultPosition: string;\n}\n\nexport interface AttachedDoc {\n  id: string;\n  name: string;\n  size: number;\n  mimeType: string;\n  textContent?: string;\n  base64Data?: string;\n}\n\ninterface HistorySnapshot {\n  editableDoc: {\n    objetivo: string;\n    alcance: string;\n    versionDesc: string;\n    clasificacion: string;\n    flowSteps: string[];\n    ownerArea: string;\n    directionArea: string;\n    trainingArea: string;\n    pages: string[];\n  };\n  manualMarkdown: string;\n  leanMarkdown: string;\n}\n\nfunction getDefaultSigners(currentDirection: string, currentDirector: string): SignerSlot[] {\n  const dirName = toTitleCase(currentDirection || \'Transporte y Log\303\255stica\');\n  let director = currentDirector || DIRECTORES_POR_DIRECCION[currentDirection] || \'Gabriel Saavedra\';\n  let directorSignature = \'\';\n\n  try {\n    const dirDirSaved = localStorage.getItem(\'canguro_directors_directory\');\n    if (dirDirSaved) {\n      const parsedDir = JSON.parse(dirDirSaved);\n      if (parsedDir && parsedDir[currentDirection]) {\n        if (parsedDir[currentDirection].directorName) {\n          director = parsedDir[currentDirection].directorName;\n        }\n        if (parsedDir[currentDirection].signatureUrl) {\n          directorSignature = parsedDir[currentDirection].signatureUrl;\n        }\n      }\n    }\n  } catch (e) {\n    console.error(e);\n  }\n\n  const isTalentoHumano = currentDirection && currentDirection.toUpperCase() === \'TALENTO HUMANO\';\n\n  try {\n    const custom = localStorage.getItem(\'canguro_default_signers\');\n    if (custom) {\n      const parsed = JSON.parse(custom);\n      // Validar que la lista personalizada contenga a Natalia Rodriguez\n      if (Array.isArray(parsed) && parsed.length >= 4 && parsed.some((s: SignerSlot) => /natalia/i.test(s.name))) {\n        const sanitized = parsed.map((s: SignerSlot, idx: number) => {\n          const fallbackSig = getOfficialSignatureFallback(s.name, s.id);\n          const sig = s.signatureUrl || fallbackSig;\n          if (idx === 3 || s.id === \'aprobado1\') {\n            return {\n              ...s,\n              name: director,\n              position: `Director de ${dirName}`,\n              signatureUrl: directorSignature || sig || \'\',\n              defaultSignatureUrl: fallbackSig\n            };\n          }\n          return {\n            ...s,\n            signatureUrl: sig,\n            defaultSignatureUrl: s.defaultSignatureUrl || fallbackSig\n          };\n        });\n        if (isTalentoHumano) {\n          return sanitized.slice(0, 4);\n        }\n        return sanitized;\n      }\n    }\n  } catch (e) {\n    console.error(e);\n  }\n\n  // Si la direcci\303\263n es TALENTO HUMANO: exactamente 4 firmantes ya que Jeanette Arvelo es la Directora del \303\241rea\n  if (isTalentoHumano) {\n    return [\n      {\n        id: \'realizado\',\n        roleLabel: \'Realizado por\',\n        name: \'Freddy Molina\',\n        position: \'Analista de Procesos\',\n        signatureUrl: FIRMA_FREDDY_MOLINA,\n        defaultSignatureUrl: FIRMA_FREDDY_MOLINA,\n        defaultName: \'Freddy Molina\',\n        defaultPosition: \'Analista de Procesos\'\n      },\n      {\n        id: \'revisado1\',\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: Arial, Helvetica, sans-serif;\n  }\n}\n\n/* Formal Page-Sheet Document Presentation - Pure Black & Arial 9.5pt (Visio A4 Landscape: 1122 x 794 px, 297 x 210 mm at 96 DPI) */\n.page-sheet {\n  background-color: #ffffff !important;\n  color: #000000 !important;\n  font-family: Arial, Helvetica, sans-serif !important;\n  font-size: 9.5pt !important;\n  line-height: 1.35;\n  box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.08), 0 1px 3px 0 rgba(0, 0, 0, 0.05);\n  border: 1px solid #9ca3af;\n  border-radius: 4px;\n  position: relative;\n  width: 1122px !important;\n  height: 794px !important;\n  min-width: 1122px !important;\n  min-height: 794px !important;\n  max-width: 1122px !important;\n  max-height: 794px !important;\n  padding: 18px 22px !important;\n  overflow: hidden !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n  box-sizing: border-box !important;\n  margin-left: auto;\n  margin-right: auto;\n}\n\n.page-sheet * {\n  color: #000000;\n  box-sizing: border-box;\n}\n\n.page-sheet p,\n.page-sheet li,\n.page-sheet td,\n.page-sheet th,\n.page-sheet div,\n.page-sheet span {\n  font-family: Arial, Helvetica, sans-serif !important;\n}\n\n/* Vertical budget strictly enforced (36px padding + 74px header + 16px margins + 586px body + 82px footer = 794px) */\n.page-sheet .header-table-container {\n  height: 74px !important;\n  min-height: 74px !important;\n  max-height: 74px !important;\n  flex-shrink: 0 !important;\n  box-sizing: border-box !important;\n}\n\n.page-sheet .page-body {\n  height: 586px !important;\n  max-height: 586px !important;\n  flex: 0 0 586px !important;\n  margin: 8px 0 !important;\n  overflow: hidden !important;\n  display: flex !important;\n  flex-direction: column !important;\n  box-sizing: border-box !important;\n}\n\n.page-sheet .signatures-footer-container {\n  height: 82px !important;\n  min-height: 82px !important;\n  max-height: 82px !important;\n  flex-shrink: 0 !important;\n  box-sizing: border-box !important;\n}\n\n/* Canguro Section Header: Oval number badge + Rounded-6px title bar */\n.canguro-section-header {\n  user-select: none;\n}\n\n.canguro-header-number-badge {\n  background-color: #fed700 !important;\n  border: 1.5px solid #000000 !important;\n  border-radius: 9999px !important;\n  color: #000000 !important;\n  font-weight: 900 !important;\n  box-sizing: border-box;\n}\n\n.canguro-header-title-bar {\n  background-color: #fed700 !important;\n  border: 1.5px solid #000000 !important;\n  border-radius: 6px !important;\n  color: #000000 !important;\n  font-weight: 900 !important;\n  text-transform: uppercase;\n  box-sizing: border-box;\n}\n\n/* Fallback for legacy canguro-pill-banner: rounded-[6px] instead of continuous stadium pill */\n.canguro-pill-banner {\n  background-color: #fed700 !important;\n  border: 1.5px solid #000000;\n  border-radius: 6px !important;\n  color: #000000 !important;\n  font-weight: 900;\n  text-transform: uppercase;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 28px;\n  box-sizing: border-box;\n}\n\n/* Atomic Cargo Block and Word-like Compact Spacing */\n.cargo-block {\n  margin-bottom: 6px;\n  padding: 2px 0;\n}\n.cargo-block:last-child {\n  margin-bottom: 0;\n}\n\n.line-spacing-1-0 {\n  line-height: 1.05 !important;\n}\n.line-spacing-1-0 p,\n.line-spacing-1-0 li,\n.line-spacing-1-0 ul,\n.line-spacing-1-0 div {\n  line-height: 1.05 !important;\n  margin-top: 1px !important;\n  margin-bottom: 1px !important;\n}\n\n.line-spacing-1-15 {\n  line-height: 1.15 !important;\n}\n.line-spacing-1-35 {\n  line-height: 1.35 !important;\n}\n\n/* In-place editing styles: Clean, unified outline on the editable block instead of excessive dashed boxes per line */\n.editing-active .editable-block {\n  outline: 1.5px dashed #f59e0b;\n  background-color: rgba(254, 215, 0, 0.03);\n  cursor: text;\n  border-radius: 4px;\n  padding: 3px 6px;\n  transition: all 0.15s ease-in-out;\n}\n\n.editing-active .editable-block:hover {\n  outline: 1.5px solid #000000;\n  background-color: rgba(254, 215, 0, 0.08);\n}\n\n.editing-active .editable-block:focus,\n.editing-active .editable-block:focus-within {\n  outline: 2px solid #000000 !important;\n  background-color: #ffffff !important;\n}\n\n@media print {\n  @page {\n    size: a4 landscape;\n    margin: 0;\n  }\n\n  body {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n    font-family: Arial, Helvetica, sans-serif !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n\n  .no-print {\n    display: none !important;\n  }\n\n  .print-only {\n    display: block !important;\n  }\n\n  .page-sheet {\n    page-break-after: always !important;\n    break-after: page !important;\n    page-break-inside: avoid !important;\n    break-inside: avoid !important;\n    box-shadow: none !important;\n    border: none !important;\n    padding: 18px 22px !important;\n    margin: 0 !important;\n    width: 297mm !important;\n    height: 210mm !important;\n    min-height: 210mm !important;\n    max-height: 210mm !important;\n... (truncated)\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport { ErrorBoundary } from \'./components/ErrorBoundary.tsx\';\nimport \'./index.css\';\n\n// Monkey-patch defensivo de Node.prototype para proteger la reconciliaci\303\263n de React contra mutaciones\n// externas del DOM producidas por contentEditable, extensiones o traducci\303\263n del navegador.\nif (typeof window !== \'undefined\' && typeof Node === \'function\' && Node.prototype) {\n  const originalRemoveChild = Node.prototype.removeChild;\n  Node.prototype.removeChild = function <T extends Node>(child: T): T {\n    if (child.parentNode !== this) {\n      if (child.parentNode) {\n        return child.parentNode.removeChild(child);\n      }\n      return child;\n    }\n    return originalRemoveChild.call(this, child) as T;\n  };\n\n  const originalInsertBefore = Node.prototype.insertBefore;\n  Node.prototype.insertBefore = function <T extends Node>(newNode: T, referenceNode: Node | null): T {\n    if (referenceNode && referenceNode.parentNode !== this) {\n      if (referenceNode.parentNode) {\n        return referenceNode.parentNode.insertBefore(newNode, referenceNode);\n      }\n      return this.appendChild(newNode) as T;\n    }\n    return originalInsertBefore.call(this, newNode, referenceNode) as T;\n  };\n}\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <ErrorBoundary>\n    <App />\n  </ErrorBoundary>\n);\n\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(typeof import.meta.dirname !== \'undefined\' ? import.meta.dirname : process.cwd(), \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
